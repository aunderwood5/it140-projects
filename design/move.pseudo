SET current_room = "Hotel Lobby"
SET game_running = TRUE

WHILE game_running = TRUE

    OUTPUT "You are in the " + current_room
    OUTPUT "Enter your move: go North, go South, go East, or go West"
    INPUT player_move

    IF player_move is "go North" OR "go South" OR "go East" OR "go West"

        SET direction = direction entered in player_move

        IF direction is a valid exit from current_room
            SET current_room = room located in that direction
            OUTPUT "You are now in the " + current_room
        ELSE
            OUTPUT "You can't go that way!"
        END IF

    ELSE
        OUTPUT "Invalid Input!"
    END IF

END WHILE
